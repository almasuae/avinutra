APP_NAME=AviNutra
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local: SQLite is fine for quick work. Production: DB_CONNECTION=mariadb (MariaDB 11.4).
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=avinutra_crm
# DB_USERNAME=avinutra_crm
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@avinutra.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Header / hero look of every public page (config/site.php hero_style): A (default) or original.
# SITE_HERO_STYLE=A

# Lite CRM package (packages/lite-crm)
LITE_CRM_PATH=crm
LITE_CRM_ENQUIRY_API=false
# The API token is created in CRM › Settings and stored hashed; it is not an .env value.

# Backups (spatie/laravel-backup; see README "Backups"). Kept on the server in
# storage/app/backups unless BACKUP_PATH is set. Set a password to encrypt the zips.
BACKUP_NAME=AviNutra
# BACKUP_PATH=/home/avinutra/backups
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=info@avinutra.com
# Folder of mariadb-dump, only if it is not on the PATH.
# DB_DUMP_BINARY_PATH=/usr/bin

# Content-Security-Policy header (App\Http\Middleware\SecurityHeaders). Leave on.
SECURITY_CSP=true
# Strict-Transport-Security, sent by Laravel over HTTPS in production. Keep true and do
# NOT also enable HSTS in HestiaCP, or the header is sent twice.
SECURITY_HSTS=true
