{
    "name": "gotrade/lite-crm",
    "description": "A light, industry-neutral CRM delivered as a Filament plugin for Laravel applications.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["laravel", "filament", "crm"],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "LiteCrm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LiteCrm\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LiteCrm\\LiteCrmServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
